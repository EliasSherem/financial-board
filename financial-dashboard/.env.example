# Server Configuration
# The port your Express server listens on
PORT=3001

# Database Configuration
# Replace with your own MySQL credentials
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=user
MYSQL_PASSWORD=pass
MYSQL_DATABASE=financial_db

# Alternatively, provide a full DSN (overrides the values above)
# MYSQL_URL=mysql://user:pass@host:3306/financial_db

# TLS/SSL options (enable if your provider requires SSL)
# MYSQL_SSL=false
# MYSQL_SSL_REJECT_UNAUTHORIZED=false
# MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=false

# JWT Secret
# Use a long, random string in production
JWT_SECRET=replace-with-a-secure-random-string

# Stripe (test mode)
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Optional: set if using webhook forwarding locally (stripe listen)
STRIPE_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXX

# App Store subscriptions
# Required for validating iOS subscription receipts on the backend.
# APPLE_SHARED_SECRET=your-app-store-shared-secret
# Optional: auto | sandbox | production
# APPLE_RECEIPT_VERIFICATION_MODE=auto

# Optional: override currency/amount for Checkout
# STRIPE_CURRENCY=usd            # e.g., mxn for Mexican Peso
# STRIPE_UNIT_AMOUNT=1000        # minor units (e.g., cents). Example: 1000 = $10.00

# Frontend base URL for redirects (Vite default)
CLIENT_URL=http://localhost:3000

# CORS for server (comma-separated)
# CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Frontend build-time API URL
# VITE_API_URL=http://localhost:3001/api

# Google Sign-In
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Resend email notifications
# RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
# RESEND_FROM=FinSight <no-reply@yourdomain.com>
# Optional: verify Resend webhook signatures
# RESEND_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
