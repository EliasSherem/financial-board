# Copy to a private environment. No production secrets belong in this file.
NODE_ENV=development
PORT=3001
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=finsight
MYSQL_PASSWORD=
MYSQL_DATABASE=finsight_local
MYSQL_SSL=false
MYSQL_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173
# Explicit trusted proxy CIDRs only when they match your deployment topology.
TRUST_PROXY_CIDRS=
# Never enable in production. New schema is installed by explicit migrations.
LEGACY_SCHEMA_BOOTSTRAP=false

# Independent rollout controls. Billing verification/webhooks remain active.
MOMENTUM_ENABLED=false
MOMENTUM_WORKER_ENABLED=true
MOMENTUM_AI_REWARDS_ENABLED=false
MOMENTUM_GRACE_ENABLED=true
MOMENTUM_PUSH_ENABLED=false
ADMIN_ANALYTICS_ENABLED=false
ANALYTICS_ENVIRONMENT=production
BILLING_CHECKOUT_ENABLED=true
BILLING_WORKER_ENABLED=true
BILLING_ALLOW_SANDBOX=false

# AI/receipt capabilities use the existing product only.
OPENAI_API_KEY=
OPENAI_TIMEOUT_MS=20000
RECEIPT_SCANNING_ENABLED=false
# Target the Firebase project used by the Android/iOS app, which may differ from Cloud Run.
# Cloud Run uses its service identity (ADC) when the JSON value is empty.
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=

# Resend sender/domain must be verified by the operator.
RESEND_API_KEY=
RESEND_FROM=
RESEND_WEBHOOK_SECRET=
RECOVERY_ORIGIN=
RECOVERY_ALLOWED_ORIGINS=
RECOVERY_RATE_SECRET=
RECOVERY_TOKEN_TTL_MINUTES=30

# Generate separate stable secrets: 32-byte base64 AES key + >=32-character HMAC secret.
# Preserve these through deployments; rotation needs an explicit re-encryption/mapping plan.
BILLING_ENCRYPTION_KEY=
BILLING_ACCOUNT_ID_SECRET=
# Workload identity is preferred; otherwise path to a private service account key.
GOOGLE_APPLICATION_CREDENTIALS=
ANDROID_PACKAGE_NAME=com.finsight.finsight
# Existing shipped IDs; verify product/base-plan availability in the actual console.
GOOGLE_PLAY_PRODUCT_IDS=finsight_monthly,finsight_pro_monthly
GOOGLE_PLAY_REQUIRE_ACCOUNT_ID=true
GOOGLE_RTDN_AUDIENCE=
GOOGLE_RTDN_SERVICE_ACCOUNT=

APPLE_BUNDLE_ID=
APPLE_APP_ID=
APPLE_PRODUCT_IDS=7T8M8X5R46,finsight_pro_monthly,finsight_monthly
APPLE_REQUIRE_ACCOUNT_TOKEN=true
APPLE_ROOT_CA_PATHS=
APPLE_PRIVATE_KEY_PATH=
APPLE_KEY_ID=
APPLE_ISSUER_ID=
APPLE_IAP_SHARED_SECRET=

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Keep the existing configured checkout price/currency; changes require owner review.
STRIPE_CURRENCY=usd
STRIPE_UNIT_AMOUNT=1000
