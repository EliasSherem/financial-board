# Build stage
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --include=dev
# Only public frontend sources enter this builder; never copy .env or server files.
COPY index.html tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts postcss.config.js tailwind.config.js ./
COPY src ./src
COPY public ./public
# VITE values are public and compiled into browser JavaScript.
ARG VITE_API_URL=/api
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_APP_VERSION
ARG VITE_SS_DASHBOARD
ARG VITE_SS_INVOICES
ARG VITE_SS_PROJECTS
ARG VITE_SS_RECURRING
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID}
ENV VITE_APP_VERSION=${VITE_APP_VERSION}
ENV VITE_SS_DASHBOARD=${VITE_SS_DASHBOARD}
ENV VITE_SS_INVOICES=${VITE_SS_INVOICES}
ENV VITE_SS_PROJECTS=${VITE_SS_PROJECTS}
ENV VITE_SS_RECURRING=${VITE_SS_RECURRING}
RUN npm run build

# Serve stage
FROM nginx:1.30-alpine
WORKDIR /usr/share/nginx/html
COPY --from=build /app/dist .
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
