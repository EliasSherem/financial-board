# Public web build allowlist. Cloud source uploads must use an equivalent allowlist.
**
!Dockerfile
!Dockerfile.web
!Dockerfile.dockerignore
!Dockerfile.web.dockerignore
!package.json
!package-lock.json
!index.html
!nginx.conf
!tsconfig.json
!tsconfig.app.json
!tsconfig.node.json
!vite.config.ts
!postcss.config.js
!tailwind.config.js
!src/
!src/**
!public/
!public/**
# Keep accidental local secrets/artifacts out even under an allowed directory.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.jks
**/*.keystore
**/.DS_Store
**/node_modules
